+//! Optional, reviewed direct-child modal authority. Native observations are
+//! internal typed values, never deserialized from a proposed tool call.
+use std::collections::HashSet;
+use std::sync::{Mutex, OnceLock};
+
+pub const FEATURE_ENV: &str = "SUPYMEM_REVIEWED_MODAL_CHILDREN";
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct ReviewedModalParent {
+    pub pid: i64,
+    pub window_id: u64,
+    pub process_start_identity: String,
+}
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum SheetInventory {
+    CompleteUniqueChild,
+    ExplicitAttributeUnsupported,
+}
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct NativeModalFacts {
+    pub parent_pid: i64,
+    pub parent_window_id: u64,
+    pub child_pid: i64,
+    pub child_window_id: u64,
+    pub process_start_before: String,
+    pub process_start_after: String,
+    pub exact_parent_ax_root: bool,
+    pub exact_child_ax_sheet: bool,
+    pub native_parent_matches: bool,
+    pub parent_sheet_inventory: SheetInventory,
+    pub parent_cg_owned: bool,
+    pub child_cg_owned: bool,
+    pub within_read_budget: bool,
+}
+pub type NativeModalResolver = fn(&ReviewedModalParent, i64, u64) -> Option<NativeModalFacts>;
+static NATIVE_RESOLVER: OnceLock<NativeModalResolver> = OnceLock::new();
+/// Only a compiled platform registration path can install this callback. There
+/// is no protocol, JSON, manifest, or model argument for replacing it.
+pub fn register_native_resolver(resolver: NativeModalResolver) -> Result<(), &'static str> {
+    NATIVE_RESOLVER
+        .set(resolver)
+        .map_err(|_| "owned_modal_resolver_already_registered")
+}
+pub fn enabled() -> bool {
+    std::env::var(FEATURE_ENV).ok().as_deref() == Some("1")
+}
+/// Peekaboo v4.5.0 SystemIdentityResolver.swift uses sec*1_000_000+usec,
+/// losslessly serialized decimal UInt64. Refuse invalid kernel/overflow facts.
+pub fn kernel_identity(seconds: u64, microseconds: u64) -> Option<String> {
+    if seconds == 0 || microseconds >= 1_000_000 {
+        return None;
+    }
+    seconds
+        .checked_mul(1_000_000)?
+        .checked_add(microseconds)
+        .map(|value| value.to_string())
+}
+/// Classify a native inventory read, not a JSON or error-prose claim.
+pub fn classify_sheet_inventory(
+    ids: Option<&[u32]>,
+    child: u32,
+    error: Option<i32>,
+    attribute_read: bool,
+) -> Option<SheetInventory> {
+    if child == 0 || !attribute_read {
+        return None;
+    }
+    match ids {
+        Some(ids) => {
+            if error.is_some()
+                || ids.len() > 32
+                || ids.iter().any(|id| *id == 0)
+                || ids.iter().enumerate().any(|(i, id)| ids[..i].contains(id))
+                || ids.iter().filter(|id| **id == child).count() != 1
+            {
+                return None;
+            }
+            Some(SheetInventory::CompleteUniqueChild)
+        }
+        None if error == Some(-25205) => Some(SheetInventory::ExplicitAttributeUnsupported),
+        None => None,
+    }
+}
+pub fn validates(
+    parent: &ReviewedModalParent,
+    pid: i64,
+    wid: u64,
+    facts: &NativeModalFacts,
+) -> bool {
+    parent.pid > 0
+        && parent.window_id > 0
+        && pid == parent.pid
+        && wid > 0
+        && wid != parent.window_id
+        && !parent.process_start_identity.is_empty()
+        && facts.parent_pid == parent.pid
+        && facts.parent_window_id == parent.window_id
+        && facts.child_pid == pid
+        && facts.child_window_id == wid
+        && facts.process_start_before == parent.process_start_identity
+        && facts.process_start_after == parent.process_start_identity
+        && facts.exact_parent_ax_root
+        && facts.exact_child_ax_sheet
+        && facts.native_parent_matches
+        && matches!(
+            facts.parent_sheet_inventory,
+            SheetInventory::CompleteUniqueChild | SheetInventory::ExplicitAttributeUnsupported
+        )
+        && facts.parent_cg_owned
+        && facts.child_cg_owned
+        && facts.within_read_budget
+}
+pub fn resolves(parent: &ReviewedModalParent, pid: i64, wid: u64) -> bool {
+    enabled()
+        && NATIVE_RESOLVER
+            .get()
+            .and_then(|resolve| resolve(parent, pid, wid))
+            .is_some_and(|facts| validates(parent, pid, wid, &facts))
+}
+fn active_children() -> &'static Mutex<HashSet<(i64, u64)>> {
+    static ACTIVE: OnceLock<Mutex<HashSet<(i64, u64)>>> = OnceLock::new();
+    ACTIVE.get_or_init(|| Mutex::new(HashSet::new()))
+}
+/// One tool-dispatch custody token, held through actual platform completion.
+/// A child is not appended to the manifest, cached, or granted to later calls.
+pub struct OwnedModalDispatchLease {
+    parent: ReviewedModalParent,
+    child: (i64, u64),
+}
+impl OwnedModalDispatchLease {
+    pub fn acquire(parent: &ReviewedModalParent, pid: i64, wid: u64) -> Result<Self, &'static str> {
+        if !resolves(parent, pid, wid) {
+            return Err("owned_modal_identity_unconfirmed");
+        }
+        let mut active = active_children()
+            .lock()
+            .map_err(|_| "owned_modal_custody_unavailable")?;
+        if !active.insert((pid, wid)) {
+            return Err("owned_modal_dispatch_busy");
+        }
+        Ok(Self {
+            parent: parent.clone(),
+            child: (pid, wid),
+        })
+    }
+    /// Re-read the native relation after queued coordination/recording and
+    /// immediately before platform invoke. No earlier proof rescues a change.
+    pub fn revalidate(&self) -> Result<(), &'static str> {
+        resolves(&self.parent, self.child.0, self.child.1)
+            .then_some(())
+            .ok_or("owned_modal_identity_changed")
+    }
+}
+impl Drop for OwnedModalDispatchLease {
+    fn drop(&mut self) {
+        if let Ok(mut active) = active_children().lock() {
+            active.remove(&self.child);
+        }
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn parent() -> ReviewedModalParent {
+        ReviewedModalParent {
+            pid: 42,
+            window_id: 10,
+            process_start_identity: "1234567".into(),
+        }
+    }
+    fn facts() -> NativeModalFacts {
+        NativeModalFacts {
+            parent_pid: 42,
+            parent_window_id: 10,
+            child_pid: 42,
+            child_window_id: 11,
+            process_start_before: "1234567".into(),
+            process_start_after: "1234567".into(),
+            exact_parent_ax_root: true,
+            exact_child_ax_sheet: true,
+            native_parent_matches: true,
+            parent_sheet_inventory: SheetInventory::CompleteUniqueChild,
+            parent_cg_owned: true,
+            child_cg_owned: true,
+            within_read_budget: true,
+        }
+    }
+    #[test]
+    fn native_inventory_unsupported_is_not_unknown_or_contradiction() {
+        assert_eq!(
+            classify_sheet_inventory(Some(&[11, 12]), 11, None, true),
+            Some(SheetInventory::CompleteUniqueChild)
+        );
+        assert_eq!(
+            classify_sheet_inventory(None, 11, Some(-25205), true),
+            Some(SheetInventory::ExplicitAttributeUnsupported)
+        );
+        for ids in [
+            Some(&[][..]),
+            Some(&[12][..]),
+            Some(&[11, 11][..]),
+            Some(&[11, 0][..]),
+        ] {
+            assert_eq!(classify_sheet_inventory(ids, 11, None, true), None);
+            assert_eq!(classify_sheet_inventory(ids, 11, Some(-25205), true), None);
+        }
+        for error in [None, Some(0), Some(-25200), Some(-25204), Some(-25206)] {
+            assert_eq!(classify_sheet_inventory(None, 11, error, true), None);
+        }
+        assert_eq!(
+            classify_sheet_inventory(None, 11, Some(-25205), false),
+            None
+        );
+    }
+    #[test]
+    fn kernel_identity_matches_pinned_sdk_and_rejects_invalid_facts() {
+        assert_eq!(kernel_identity(1234, 567890), Some("1234567890".into()));
+        assert_eq!(kernel_identity(0, 1), None);
+        assert_eq!(kernel_identity(1, 1_000_000), None);
+        assert_eq!(kernel_identity(u64::MAX, 0), None);
+    }
+    #[test]
+    fn unsupported_inventory_never_rescues_missing_parent_binding() {
+        let mut f = facts();
+        f.parent_sheet_inventory = SheetInventory::ExplicitAttributeUnsupported;
+        assert!(validates(&parent(), 42, 11, &f));
+        f.native_parent_matches = false;
+        assert!(!validates(&parent(), 42, 11, &f));
+    }
+    #[test]
+    fn exact_direct_child_requires_every_native_fact() {
+        assert!(validates(&parent(), 42, 11, &facts()));
+        for i in 0..6 {
+            let mut f = facts();
+            match i {
+                0 => f.exact_parent_ax_root = false,
+                1 => f.exact_child_ax_sheet = false,
+                2 => f.native_parent_matches = false,
+                3 => f.parent_cg_owned = false,
+                4 => f.child_cg_owned = false,
+                _ => f.within_read_budget = false,
+            };
+            assert!(!validates(&parent(), 42, 11, &f));
+        }
+    }
+    #[test]
+    fn stale_foreign_reused_pid_decoy_root_and_recursive_scope_hold() {
+        for i in 0..6 {
+            let mut f = facts();
+            match i {
+                0 => f.parent_pid = 43,
+                1 => f.child_pid = 43,
+                2 => f.parent_window_id = 12,
+                3 => f.child_window_id = 12,
+                4 => f.process_start_before = "other".into(),
+                _ => f.process_start_after = "other".into(),
+            };
+            assert!(!validates(&parent(), 42, 11, &f));
+        }
+        assert!(!validates(&parent(), 42, 10, &facts()));
+        assert!(!validates(&parent(), 43, 11, &facts()));
+        assert!(!validates(&parent(), 42, 0, &facts()));
+    }
+    #[test]
+    fn lease_is_single_dispatch_fresh_revalidated_and_released() {
+        use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+        static PRESENT: AtomicBool = AtomicBool::new(true);
+        static READS: AtomicUsize = AtomicUsize::new(0);
+        fn native(_: &ReviewedModalParent, pid: i64, wid: u64) -> Option<NativeModalFacts> {
+            READS.fetch_add(1, Ordering::SeqCst);
+            PRESENT.load(Ordering::SeqCst).then(|| {
+                let mut f = facts();
+                f.child_pid = pid;
+                f.child_window_id = wid;
+                f
+            })
+        }
+        std::env::remove_var(FEATURE_ENV);
+        register_native_resolver(native).unwrap();
+        assert!(OwnedModalDispatchLease::acquire(&parent(), 42, 11).is_err());
+        assert_eq!(READS.load(Ordering::SeqCst), 0);
+        std::env::set_var(FEATURE_ENV, "true");
+        assert!(OwnedModalDispatchLease::acquire(&parent(), 42, 11).is_err());
+        std::env::set_var(FEATURE_ENV, "1");
+        let lease = OwnedModalDispatchLease::acquire(&parent(), 42, 11).unwrap();
+        assert!(matches!(
+            OwnedModalDispatchLease::acquire(&parent(), 42, 11),
+            Err("owned_modal_dispatch_busy")
+        ));
+        let other = OwnedModalDispatchLease::acquire(&parent(), 42, 12).unwrap();
+        assert!(lease.revalidate().is_ok());
+        PRESENT.store(false, Ordering::SeqCst);
+        assert_eq!(lease.revalidate(), Err("owned_modal_identity_changed"));
+        drop(lease);
+        drop(other);
+        PRESENT.store(true, Ordering::SeqCst);
+        assert!(OwnedModalDispatchLease::acquire(&parent(), 42, 11).is_ok());
+        std::env::remove_var(FEATURE_ENV);
+        assert!(!resolves(&parent(), 42, 11));
+        assert!(register_native_resolver(native).is_err());
+    }
+}
