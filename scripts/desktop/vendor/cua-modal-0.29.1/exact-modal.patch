+    /// The caller must already hold its admitted GenericKey mutation lease.
+    pub unsafe fn capture_key(
+        pid: i32,
+        wid: u32,
+        element: Option<usize>,
+        trace: Trace,
+    ) -> Option<Self> {
+        if let Some(element) = element {
+            return Self::capture(element as AXUIElementRef, pid, wid, trace);
