+//! Pure admission for a nested native window/sheet. Geometry is never authority.
+#[derive(Debug)]
+pub struct SurfaceFacts {
+    pub pid: Option<i32>,
+    pub native_window_role: bool,
+    pub parent_matches: bool,
+    pub window_id: Option<u32>,
+    pub parent_window_id: Option<u32>,
+    pub cg_owned: bool,
+    pub parent_cg_owned: bool,
+}
+pub fn admit(pid: i32, facts: &SurfaceFacts) -> Option<u32> {
+    let wid = facts.window_id?;
+    let parent = facts.parent_window_id?;
+    (pid > 0
+        && facts.pid == Some(pid)
+        && facts.native_window_role
+        && facts.parent_matches
+        && wid > 0
+        && parent > 0
+        && wid != parent
+        && facts.cg_owned
+        && facts.parent_cg_owned)
+        .then_some(wid)
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn facts() -> SurfaceFacts {
+        SurfaceFacts {
+            pid: Some(7),
+            native_window_role: true,
+            parent_matches: true,
+            window_id: Some(22),
+            parent_window_id: Some(11),
+            cg_owned: true,
+            parent_cg_owned: true,
+        }
+    }
+    #[test]
+    fn nested_exact_surface_admits_its_own_identity() {
+        assert_eq!(admit(7, &facts()), Some(22));
+    }
+    #[test]
+    fn unknown_spi_identity_never_uses_frame_overlap() {
+        let mut f = facts();
+        f.window_id = None;
+        assert_eq!(admit(7, &f), None);
+    }
+    #[test]
+    fn wrong_or_unknown_pid_never_admits() {
+        for pid in [None, Some(8)] {
+            let mut f = facts();
+            f.pid = pid;
+            assert_eq!(admit(7, &f), None);
+        }
+    }
+    #[test]
+    fn ambiguous_or_absent_parentage_never_admits() {
+        let mut f = facts();
+        f.parent_matches = false;
+        assert_eq!(admit(7, &f), None);
+        f = facts();
+        f.parent_window_id = None;
+        assert_eq!(admit(7, &f), None);
+        f = facts();
+        f.parent_window_id = f.window_id;
+        assert_eq!(admit(7, &f), None);
+    }
+    #[test]
+    fn closed_or_foreign_cg_owner_never_admits() {
+        let mut f = facts();
+        f.cg_owned = false;
+        assert_eq!(admit(7, &f), None);
+    }
+}
+
+#[cfg(test)]
+mod parent_tests {
+    use super::*;
+    #[test]
+    fn closed_parent_never_admits_a_nested_surface() {
