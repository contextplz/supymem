+        ] {
+            let r = click_record(false, false, noop, false, None, None, 42, 10);
+            assert_eq!(r.effect, expected);
+            assert!(r.public_result().is_ok());
+        }
+        assert_eq!(
+            key_record(false, None, false, 42, Some(10)).effect,
+            ActionEffect::Unverifiable
+        );
+    }
+    #[test]
+    fn canonical_contradictory_noop_cannot_promote_any_readback() {
+        for (selection, transition, control) in [
+            (true, None, None),
+            (false, Some(Transition::ModalClosed), None),
+            (false, Some(Transition::WindowAbsent), None),
+            (false, None, Some(Kind::CheckBox)),
+        ] {
+            let r = click_record(false, false, true, selection, transition, control, 42, 10);
+            assert_eq!(r.effect, ActionEffect::SuspectedNoop);
+            assert!(r.public_result().is_ok());
+        }
+    }
+    #[test]
+    fn canonical_all_closed_native_postconditions_survive() {
+        for t in [
+            Transition::ModalOpened,
+            Transition::ModalClosed,
+            Transition::WindowAbsent,
+        ] {
+            let c = click_record(false, false, false, false, Some(t), None, 42, 10);
+            let k = key_record(false, Some(t), false, 42, Some(10));
+            for r in [c, k] {
+                assert_eq!(r.effect, ActionEffect::Confirmed);
+                let public = r.public_result().unwrap();
+                assert!(!public.evidence.unwrap().is_empty());
+            }
+        }
+        for kind in [
+            Kind::CheckBox,
+            Kind::RadioButton,
+            Kind::Disclosure,
+            Kind::Selection,
+        ] {
+            let r = click_record(false, false, false, false, None, Some(kind), 42, 10);
+            assert_eq!(r.effect, ActionEffect::Confirmed);
+            assert!(r.public_result().is_ok());
+        }
+    }
+    #[test]
+    fn canonical_invalid_scope_and_transport_cannot_promote_readback() {
+        for (pid, wid) in [(0, 10), (42, 0)] {
+            assert_eq!(
+                click_record(
+                    false,
+                    false,
+                    false,
+                    true,
+                    Some(Transition::ModalClosed),
+                    Some(Kind::CheckBox),
+                    pid,
+                    wid
+                )
+                .effect,
+                ActionEffect::Unverifiable
+            );
+            assert_eq!(
+                key_record(false, Some(Transition::ModalClosed), true, pid, Some(wid)).effect,
+                ActionEffect::Unverifiable
+            );
+        }
+        for (fg, pixel) in [(true, false), (false, true)] {
+            assert_eq!(
+                click_record(
+                    fg,
+                    pixel,
+                    false,
+                    false,
+                    Some(Transition::WindowAbsent),
+                    Some(Kind::CheckBox),
+                    42,
+                    10
+                )
+                .effect,
+                ActionEffect::Unverifiable
+            );
+        }
+        assert_eq!(
+            key_record(true, Some(Transition::ModalClosed), false, 42, Some(10)).effect,
+            ActionEffect::Unverifiable
+        );
+    }
+    #[test]
+    fn canonical_selection_uses_actual_transport_and_closed_private_evidence() {
+        for (fg, pixel) in [(false, false), (false, true), (true, true)] {
+            let r = click_record(fg, pixel, false, true, None, None, 42, 10);
+            assert_eq!(r.effect, ActionEffect::Confirmed);
+            assert_eq!(
+                r.transport,
+                if pixel {
+                    if fg {
+                        ActionTransport::MacosCgEventHid
+                    } else {
+                        ActionTransport::MacosCgEventPid
+                    }
+                } else {
+                    ActionTransport::MacosAxAction
+                }
+            );
+            assert!(r.public_result().is_ok());
+            assert!(r
+                .evidence
+                .iter()
+                .all(|e| !e.detail.contains("42") && !e.detail.contains("10")));
+        }
+    }
+}
