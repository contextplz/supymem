+++ b/crates/platform-macos/src/ax/control_probe.rs
@@ -0,0 +1,117 @@
+//! Read-only postcondition probe for an exact retained standard native control.
+//! No strings/state values are emitted, no input/retry/activation is performed.
+use super::{
+    bindings::*,
+    control_state::{self, Kind, State},
+};
+use core_foundation::base::{CFRelease, CFRetain, CFTypeRef};
+use std::time::{Duration, Instant};
+struct Element(AXUIElementRef);
+impl Drop for Element {
+    fn drop(&mut self) {
+        unsafe {
+            CFRelease(self.0 as CFTypeRef);
+        }
+    }
+}
+struct Timeout(AXUIElementRef);
+impl Timeout {
+    unsafe fn set(element: AXUIElementRef) -> Option<Self> {
+        (AXUIElementSetMessagingTimeout(element, 0.02) == kAXErrorSuccess).then_some(Self(element))
+    }
+}
+impl Drop for Timeout {
+    fn drop(&mut self) {
+        unsafe {
+            AXUIElementSetMessagingTimeout(self.0, 0.0);
+        }
+    }
+}
+unsafe fn observe(
+    element: AXUIElementRef,
+    pid: i32,
+    wid: u32,
+) -> Option<(State, String, Option<String>)> {
+    let _timeout = Timeout::set(element)?;
+    if pid <= 0 || wid == 0 || element_pid(element) != Some(pid) {
+        return None;
+    }
+    drop(_timeout);
+    if super::exact_target::element_window_id(element) != Some(wid) {
+        return None;
+    }
+    let _timeout = Timeout::set(element)?;
+    let role = copy_string_attr(element, "AXRole")?;
+    let subrole = copy_string_attr(element, "AXSubrole");
+    if subrole.as_ref().is_some_and(|s| s.len() > 64) {
+        return None;
+    }
+    let kind = control_state::policy(&role, subrole.as_deref())?;
+    let state = State {
+        pid,
+        window_id: wid,
+        kind,
+        identity_proved: true,
+        enabled: copy_binary_attr(element, "AXEnabled"),
+        value: copy_binary_attr(element, kind.attribute()),
+    };
+    Some((state, role, subrole))
+}
+pub struct ControlProbe {
+    element: Element,
+    before: State,
+    role: String,
+    subrole: Option<String>,
+}
+impl ControlProbe {
+    /// Caller holds the exact admitted per-PID mutation lease. Retain the
+    /// same AX identity across one advertised plain background AXPress only.
+    pub unsafe fn capture(element: AXUIElementRef, pid: i32, wid: u32) -> Option<Self> {
+        let began = Instant::now();
+        let (before, role, subrole) = observe(element, pid, wid)?;
+        if before.enabled != Some(true) || before.value.is_none() {
+            return None;
+        }
+        let _timeout = Timeout::set(element)?;
+        if !copy_action_names(element).iter().any(|a| a == "AXPress")
+            || began.elapsed() > Duration::from_millis(250)
+        {
+            return None;
+        }
+        CFRetain(element as CFTypeRef);
+        Some(Self {
+            element: Element(element),
+            before,
+            role,
+            subrole,
+        })
+    }
+    unsafe fn read(&self) -> Option<State> {
+        let (state, role, subrole) =
+            observe(self.element.0, self.before.pid, self.before.window_id)?;
+        (role == self.role && subrole == self.subrole).then_some(state)
+    }
+    /// Require two fresh scoped reads of the same expected transition. Time
+    /// bounds further work but is never evidence; unknown/transient state holds.
+    pub unsafe fn after_acknowledged(&self) -> Option<Kind> {
+        let began = Instant::now();
+        for _ in 0..3 {
+            if began.elapsed() > Duration::from_millis(450) {
+                return None;
+            }
+            let after = self.read()?;
+            if began.elapsed() > Duration::from_millis(450) {
+                return None;
+            }
+            std::thread::sleep(Duration::from_millis(40));
+            let stable = self.read()?;
+            if began.elapsed() > Duration::from_millis(450) {
+                return None;
+            }
+            if control_state::confirms(self.before, after, stable) {
+                return Some(self.before.kind);
+            }
+        }
+        None
+    }
+}
