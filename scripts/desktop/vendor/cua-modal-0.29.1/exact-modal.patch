+            super::press_diagnostic::cg_facts(owner, scope.pid);
+        sample.parent_cg_owned = super::press_diagnostic::cg_facts(parent_owner, scope.pid).1;
+        // Ancestry was checked during capture. No fresh ancestry fact is invented.
+        let observation = Observation {
+            target_owned: owner == Some(Some(scope.pid)),
+            ax_root_exact: false, // after root may be gone; capture facts are not invented
+            target_absent: owner == Some(None),
+            parent_owned: scope.parent_window_id.is_some() && parent_owner == Some(Some(scope.pid)),
+            sheets: sheets(
+                root,
+                scope.pid,
+                root_wid,
+                Instant::now(),
+                &self.trace,
+                Stage::AfterAck,
+                sample_index,
+            ),
+            scope,
+        };
