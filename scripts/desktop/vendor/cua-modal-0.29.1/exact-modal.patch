diff --git a/crates/platform-macos/src/ax/action_error.rs b/crates/platform-macos/src/ax/action_error.rs
new file mode 100644
--- /dev/null
+++ b/crates/platform-macos/src/ax/action_error.rs
@@ -0,0 +1,69 @@
+//! Closed AX dispatch failure metadata. No element labels, action prose or replay.
+//! Mapping follows Apple's AXError.h (macOS SDK 15.5); unknown numeric values
+//! remain withheld. A failed return never proves that no effect occurred.
+use std::fmt;
+
+#[derive(Debug)]
+pub struct AxActionError(i32);
+
+impl AxActionError {
+    pub fn from_return(code: i32) -> Option<Self> {
+        (code != 0).then_some(Self(code))
+    }
+
+    pub fn known(&self) -> Option<(i32, &'static str)> {
+        let name = match self.0 {
+            -25200 => "failure",
+            -25201 => "illegal_argument",
+            -25202 => "invalid_ui_element",
+            -25203 => "invalid_ui_element_observer",
+            -25204 => "cannot_complete",
+            -25205 => "attribute_unsupported",
+            -25206 => "action_unsupported",
+            -25207 => "notification_unsupported",
+            -25208 => "not_implemented",
+            -25209 => "notification_already_registered",
+            -25210 => "notification_not_registered",
+            -25211 => "api_disabled",
+            -25212 => "no_value",
+            -25213 => "parameterized_attribute_unsupported",
+            -25214 => "not_enough_precision",
+            _ => return None,
+        };
+        Some((self.0, name))
+    }
+}
+
+impl fmt::Display for AxActionError {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("Native AX dispatch failed; effect unconfirmed")
+    }
+}
+impl std::error::Error for AxActionError {}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn known_apple_returns_map_exactly_without_private_context() {
+        let names = ["failure", "illegal_argument", "invalid_ui_element", "invalid_ui_element_observer",
+            "cannot_complete", "attribute_unsupported", "action_unsupported", "notification_unsupported",
+            "not_implemented", "notification_already_registered", "notification_not_registered", "api_disabled",
+            "no_value", "parameterized_attribute_unsupported", "not_enough_precision"];
+        for (offset, name) in names.into_iter().enumerate() {
+            let code = -25200 - offset as i32;
+            let error = AxActionError::from_return(code).expect("nonzero native return");
+            assert_eq!(error.known(), Some((code, name)));
+            assert_eq!(error.to_string(), "Native AX dispatch failed; effect unconfirmed");
+        }
+    }
+    #[test]
+    fn success_is_not_an_error_and_unknown_numbers_are_withheld() {
+        assert!(AxActionError::from_return(0).is_none());
+        for code in [1, -1, -25215, -25199, i32::MIN, i32::MAX] {
+            let error = AxActionError::from_return(code).unwrap();
+            assert_eq!(error.known(), None);
+            assert!(!error.to_string().contains(&code.to_string()));
+        }
+    }
+}
