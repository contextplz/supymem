+//! Read-only exact-surface postcondition probe, reusable by an acknowledged
+//! scoped transport. This helper never dispatches, activates, retries, or logs.
+use super::{
+    bindings::*,
+    press_diagnostic::{Reason, Sample, Stage, Trace},
+    press_readback::{self, Observation, Scope, Transition},
+};
+use core_foundation::{
+    array::CFArray,
+    base::{CFEqual, CFGetTypeID, CFRelease, CFRetain, CFTypeRef, TCFType},
+    string::CFString,
+};
+use std::time::{Duration, Instant};
+
+struct Element(AXUIElementRef);
+impl Drop for Element {
+    fn drop(&mut self) {
+        unsafe {
+            CFRelease(self.0 as CFTypeRef);
+        }
+    }
+}
+struct Timeout(AXUIElementRef);
+impl Timeout {
+    unsafe fn set(element: AXUIElementRef) -> Option<Self> {
+        (AXUIElementSetMessagingTimeout(element, 0.02) == kAXErrorSuccess).then_some(Self(element))
+    }
+}
+impl Drop for Timeout {
+    fn drop(&mut self) {
+        unsafe {
+            AXUIElementSetMessagingTimeout(self.0, 0.0);
+        }
+    }
+}
+fn owned(pid: i32, wid: u32) -> bool {
+    matches!(
+        crate::windows::resolve_window_owner(pid, wid),
+        crate::windows::WindowOwner::SamePid
+    )
+}
+fn native_generation(pid:i32)->Option<String> {
+    let (sec,usec)=super::enablement::process_start_stamp(pid)?;
+    cua_driver_core::owned_modal::kernel_identity(sec,usec)
+}
+// Unlike copy_children(), unavailable/malformed/partial is None, not an empty list.
+unsafe fn sheets(
+    root: AXUIElementRef,
+    pid: i32,
+    wid: u32,
+    began: Instant,
+    trace: &Trace,
+    stage: Stage,
+    sample_index: u8,
+) -> Option<Vec<u32>> {
+    let fail = |reason, code, attribute_read| {
+        let mut sample = Sample::new(stage, reason);
+        sample.sample_index = sample_index;
+        sample.ax_error_code = code;
+        sample.sheets_available =
+            super::press_diagnostic::sheets_availability(reason, attribute_read);
+        trace.push(sample);
+    };
+    let _timeout = Timeout::set(root).or_else(|| {
+        fail(Reason::Timeout, None, false);
+        None
+    })?;
+    if element_pid(root) != Some(pid) || ax_get_window_id(root) != Some(wid) || !owned(pid, wid) {
+        fail(Reason::ParentUnknown, None, false);
+        return None;
+    }
+    let attr = CFString::new("AXSheets");
+    let mut value: CFTypeRef = std::ptr::null();
+    let err = AXUIElementCopyAttributeValue(root, attr.as_concrete_TypeRef(), &mut value);
+    if err != kAXErrorSuccess || value.is_null() {
+        if !value.is_null() {
+            CFRelease(value);
+        }
+        fail(Reason::SheetsUnknown, Some(err), true);
+        return None;
+    }
+    if CFGetTypeID(value) != CFArray::<CFTypeRef>::type_id() {
+        CFRelease(value);
+        fail(Reason::SheetsMalformed, None, true);
+        return None;
+    }
+    let array = CFArray::<CFTypeRef>::wrap_under_create_rule(value as _);
+    if array.len() > 32 {
+        fail(Reason::SheetsPartial, None, true);
+        return None;
+    }
+    let mut ids = Vec::new();
+    for index in 0..array.len() {
+        if began.elapsed() > Duration::from_millis(150) {
+            fail(Reason::SheetsPartial, None, true);
+            return None;
+        }
+        let item = *array.get(index).or_else(|| {
+            fail(Reason::SheetsPartial, None, true);
+            None
+        })?;
+        if item.is_null() || CFGetTypeID(item) != AXUIElementGetTypeID() {
+            fail(Reason::SheetsMalformed, None, true);
+            return None;
+        }
+        let child = item as AXUIElementRef;
+        let _timeout = Timeout::set(child).or_else(|| {
+            fail(Reason::Timeout, None, true);
+            None
+        })?;
+        if element_pid(child) != Some(pid)
+            || copy_string_attr(child, "AXRole").as_deref() != Some("AXSheet")
+        {
+            fail(Reason::SheetsMalformed, None, true);
+            return None;
+        }
+        let parent = Element(copy_element_attr(child, "AXParent").or_else(|| {
+            fail(Reason::ParentUnknown, None, true);
+            None
+        })?);
+        if CFEqual(parent.0 as CFTypeRef, root as CFTypeRef) == 0 {
+            fail(Reason::SheetsMalformed, None, true);
+            return None;
+        }
+        let id = ax_get_window_id(child).or_else(|| {
+            fail(Reason::AncestryUnknown, None, true);
+            None
+        })?;
+        if id == 0 || id == wid || ids.contains(&id) || !owned(pid, id) {
+            fail(Reason::SheetsMalformed, None, true);
+            return None;
+        }
+        ids.push(id);
+    }
+    ids.sort_unstable();
+    let mut sample = Sample::new(stage, Reason::SheetsComplete);
+    sample.sample_index = sample_index;
+    sample.sheets_available = Some(true);
+    sample.sheets_count = Some(ids.len() as u8);
+    trace.push(sample);
+    Some(ids)
+}
+/// Holds native identities from BEFORE a single admitted mutation. Keep the
+/// caller's per-PID mutation lease across capture, dispatch and readback.
+pub struct Probe {
+    root: Element,
+    parent: Option<Element>,
+    before: Observation,
+    trace: Trace,
+    sheet_absence: Option<press_readback::SheetAbsenceCapture>,
