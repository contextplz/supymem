+            pid: Some(7),
+            native_window_role: true,
+            parent_matches: true,
+            window_id: Some(22),
+            parent_window_id: Some(11),
+            cg_owned: true,
+            parent_cg_owned: false,
+        };
+        assert_eq!(admit(7, &f), None);
+    }
+}
