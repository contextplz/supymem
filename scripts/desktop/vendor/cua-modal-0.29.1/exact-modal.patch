new file mode 100644
--- /dev/null
+++ b/crates/platform-macos/src/ax/action_receipt.rs
@@ -0,0 +1,317 @@
+//! Source-owned canonical records for acknowledged native input. No legacy JSON
+//! or caller-authored verified flag is consulted. Readback proves only the named
+//! scoped postcondition, never task completion or business acceptance.
+use super::{control_state::Kind, press_readback::Transition};
+use cua_driver_core::action_record::{
+    ActionEffect, ActionEvidence, ActionExecutionRecord, ActionTransport, ActualDelivery,
+    EvidenceKind, RequestedDelivery,
+};
+
+pub fn click_record(
+    foreground: bool,
+    pixel_selection: bool,
+    suspected_noop: bool,
+    selection_readback: bool,
+    transition: Option<Transition>,
+    control: Option<Kind>,
+    pid: i32,
+    window_id: u32,
+) -> ActionExecutionRecord {
+    let scoped = !suspected_noop && pid > 0 && window_id > 0;
+    let transition = if scoped && !foreground && !pixel_selection {
+        transition
+    } else {
+        None
+    };
+    let control = if scoped && !foreground && !pixel_selection {
+        control
+    } else {
+        None
+    };
+    let evidence = if let Some(transition) = transition {
+        Some(transition_evidence(transition))
+    } else if let Some(control) = control {
+        Some(ActionEvidence { kind: EvidenceKind::AccessibilityReadback, detail: match control {
+            Kind::CheckBox => "the exact enabled same-PID same-window checkbox binary value toggled and remained stable",
+            Kind::RadioButton => "the exact enabled same-PID same-window radio binary value changed from unselected to selected and remained stable",
+            Kind::Disclosure => "the exact enabled same-PID same-window disclosure expansion toggled and remained stable",
+            Kind::Selection => "the exact enabled same-PID same-window control changed from unselected to selected and remained stable",
+        }.into() })
+    } else if scoped && selection_readback {
+        Some(ActionEvidence { kind: EvidenceKind::AccessibilityReadback,
+            detail: "the same native AX selection was independently read back after the acknowledged input".into() })
+    } else {
+        None
+    };
+    let transport = if pixel_selection {
+        if foreground {
+            ActionTransport::MacosCgEventHid
+        } else {
+            ActionTransport::MacosCgEventPid
+        }
+    } else {
+        ActionTransport::MacosAxAction
+    };
+    record(foreground, transport, suspected_noop, evidence)
+}
+
+pub fn key_record(
+    foreground: bool,
+    transition: Option<Transition>,
+    value_selection_readback: bool,
+    pid: i32,
+    window_id: Option<u32>,
+) -> ActionExecutionRecord {
+    let scoped = pid > 0 && window_id.is_some_and(|id| id > 0);
+    let evidence = if scoped && !foreground {
+        transition.map(transition_evidence)
+    } else { None }.or_else(|| (scoped && value_selection_readback).then(|| ActionEvidence {
+        kind: EvidenceKind::AccessibilityReadback,
+        detail: "the same native AX element changed value or selection after the acknowledged key post".into(),
+    }));
+    record(
+        foreground,
+        if foreground {
+            ActionTransport::MacosCgEventHid
+        } else {
+            ActionTransport::MacosCgEventPid
+        },
+        false,
+        evidence,
+    )
+}
+
+fn transition_evidence(transition: Transition) -> ActionEvidence {
+    ActionEvidence { kind: if transition == Transition::WindowAbsent { EvidenceKind::WindowChange }
+        else { EvidenceKind::AccessibilityReadback }, detail: match transition {
+        Transition::ModalOpened => "the exact target acquired one newly admitted child modal after the acknowledged input",
+        Transition::ModalClosed => "the exact admitted modal closed while its same-PID parent remained live after the acknowledged input",
+        Transition::WindowAbsent => "the freshly bound exact owned AX root window was absent from a successful complete CG inventory after the acknowledged input; this observed postcondition does not prove task completion or distinguish external closure",
+    }.into() }
+}
+
+fn record(
+    foreground: bool,
+    transport: ActionTransport,
+    suspected_noop: bool,
+    evidence: Option<ActionEvidence>,
+) -> ActionExecutionRecord {
+    let effect = if evidence.is_some() {
+        ActionEffect::Confirmed
+    } else if suspected_noop {
+        ActionEffect::SuspectedNoop
+    } else {
+        ActionEffect::Unverifiable
+    };
+    let mut builder = ActionExecutionRecord::builder(
+        effect,
+        transport,
+        if foreground {
+            RequestedDelivery::Foreground
+        } else {
+            RequestedDelivery::Background
+        },
+    )
+    .actual_delivery(if foreground {
+        ActualDelivery::Foreground
+    } else {
+        ActualDelivery::Background
+    });
+    if let Some(evidence) = evidence {
+        builder = builder.evidence(evidence);
+    } else {
+        builder = builder.evidence(ActionEvidence {
+            kind: EvidenceKind::NativeApiResult,
+            detail: "native input was acknowledged; consumption and task outcome remain unverified"
+                .into(),
+        });
+    }
+    builder
+        .build()
+        .expect("closed native readback record is valid")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn canonical_unsupported_sheet_absence_is_observed_window_change_only() {
+        use super::super::press_readback::{
