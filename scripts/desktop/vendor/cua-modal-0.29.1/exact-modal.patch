+//! Closed metadata only. No native handles, titles, values, coordinates or prose.
+use std::sync::{Arc, Mutex};
+macro_rules! names {
+    ($name:ident {$($variant:ident => $wire:literal),* $(,)?}) => {
+        #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+        pub enum $name {$($variant),*}
+        impl $name {pub fn label(self) -> &'static str {match self {$(Self::$variant => $wire),*}}}
+    }
+}
+names!(Stage {Capture => "capture_preflight", AfterAck => "after_ack_sample", Final => "after_ack_final"});
+names!(Reason {NotEligible => "not_eligible", OwnerUnknown => "target_owner_unconfirmed", Timeout => "ax_timeout_unavailable",
+    FocusUnknown => "focused_element_unavailable", ButtonUnknown => "button_capability_unavailable",
+    AncestryUnknown => "ancestry_unavailable", AncestryMismatch => "ancestry_identity_mismatch",
+    ParentUnknown => "parent_identity_unavailable", ParentMismatch => "parent_identity_mismatch",
+    SheetsUnknown => "sheets_unavailable", SheetsMalformed => "sheets_malformed", SheetsPartial => "sheets_partial",
+    SheetsComplete => "sheets_complete", TargetNotListed => "target_sheet_not_listed", Captured => "capture_complete",
+    Unchanged => "postcondition_unconfirmed", Confirmed => "postcondition_confirmed", Budget => "sample_budget_exhausted"});
+/// Availability is unknown before the attribute call, independent of the gate failure.
+pub fn sheets_availability(reason: Reason, attribute_read: bool) -> Option<bool> {
+    if !attribute_read {
+        None
+    } else {
+        Some(reason != Reason::SheetsUnknown)
+    }
+}
+/// Complete CG inventory distinguishes unknown, absent and foreign owners.
