+//! Closed postconditions for one acknowledged AXPress; no input retry and no
+//! general tree/screenshot delta can establish a confirmed effect.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Scope {
+    pub pid: i32,
+    pub window_id: u32,
+    pub parent_window_id: Option<u32>,
+    pub sheet: bool,
+}
+#[derive(Clone, Debug)]
+pub struct Observation {
+    pub scope: Scope,
+    pub target_owned: bool,
+    // Source capture bound the fresh AX root to the exact PID and CG window.
+    pub ax_root_exact: bool,
+    pub target_absent: bool,
+    pub parent_owned: bool,
+    // None means unavailable/partial, never an empty inventory.
+    pub sheets: Option<Vec<u32>>,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Transition {
+    ModalOpened,
+    ModalClosed,
+    /// Exact target no longer occurs in a successful CG query; not task success.
+    WindowAbsent,
+}
+impl Transition {
+    pub fn evidence_kind(self) -> &'static str {
+        match self {
+            Self::WindowAbsent => "exact_owned_window_absence",
+            _ => "exact_modal_readback",
+        }
+    }
+    pub fn protocol(self) -> &'static str {
+        match self {
+            Self::WindowAbsent => "supymem_exact_window_absence_v1",
+            _ => "supymem_exact_modal_v1",
+        }
+    }
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::ModalOpened => "opened",
+            Self::ModalClosed => "closed",
+            Self::WindowAbsent => "absent",
+        }
+    }
+}
+/// Separately typed native binding when the exact direct sheet parent was
+/// proved but its AXSheets attribute explicitly does not exist. Not modal proof.
+#[derive(Clone, Debug)]
+pub struct SheetAbsenceCapture {
+    scope: Scope,
+    generation: String,
+}
+impl SheetAbsenceCapture {
+    pub fn capture(
+        before: &Observation,
+        direct_parent_exact: bool,
+        unsupported: bool,
+        generation_before: Option<&str>,
+        generation_after: Option<&str>,
+    ) -> Option<Self> {
+        let generation = generation_before?;
+        if !before.scope.sheet
+            || !before.target_owned
+            || before.target_absent
+            || !before.ax_root_exact
+            || !before.parent_owned
+            || !direct_parent_exact
+            || !unsupported
+            || before.sheets.is_some()
+            || generation.is_empty()
+            || generation_after != Some(generation)
+            || before.scope.pid <= 0
+            || before.scope.window_id == 0
+            || before
+                .scope
+                .parent_window_id
+                .is_none_or(|p| p == 0 || p == before.scope.window_id)
+        {
+            return None;
+        }
+        Some(Self {
+            scope: before.scope.clone(),
+            generation: generation.into(),
+        })
+    }
+    pub fn confirm(
+        &self,
+        after: &Observation,
+        parent_exact: bool,
+        generation: Option<&str>,
+        unsupported_after: bool,
+    ) -> Option<Transition> {
+        (after.scope == self.scope
+            && parent_exact
+            && after.parent_owned
+            && generation == Some(self.generation.as_str())
+            && absence_inventory_acceptable(
+                after.sheets.as_deref(),
+                self.scope.window_id,
+                unsupported_after,
+            )
+            && after.target_absent
+            && !after.target_owned)
+            .then_some(Transition::WindowAbsent)
+    }
+}
+/// A complete inventory cannot contradict an observed absence; unavailable is
+/// admitted only for a positively identified native unsupported attribute.
+pub fn absence_inventory_acceptable(ids: Option<&[u32]>, target: u32, unsupported: bool) -> bool {
+    match ids {
+        Some(ids) => {
+            !unsupported
+                && ids.len() <= 32
+                && ids.iter().all(|id| *id > 0)
+                && ids.iter().enumerate().all(|(i, id)| !ids[..i].contains(id))
+                && !ids.contains(&target)
+        }
+        None => unsupported,
+    }
+}
+/// A scoped readback cannot expand the transport admitted by the caller.
+pub fn eligible_key_probe(
+    foreground: bool,
+    coordinate_focus: bool,
+    window_id: Option<u32>,
+    lease: bool,
+) -> bool {
+    !foreground && !coordinate_focus && lease && window_id.is_some_and(|id| id > 0)
+}
+/// Exactly one dispatch, readback only after acknowledgement. Errors propagate
+/// unchanged; no replay/fallback or readback can turn a rejected post into success.
+pub fn dispatch_once<T, E>(
+    dispatch: impl FnOnce() -> Result<T, E>,
+    readback: impl FnOnce() -> Option<Transition>,
+) -> Result<(T, Option<Transition>), E> {
+    let acknowledgement = dispatch()?;
+    Ok((acknowledgement, readback()))
+}
+pub fn confirm(before: &Observation, after: &Observation) -> Option<Transition> {
+    if before.scope != after.scope
+        || before.scope.pid <= 0
+        || before.scope.window_id == 0
+        || !before.ax_root_exact
+        || !before.target_owned
+        || before.target_absent
+    {
+        return None;
+    }
+    // Missing AXSheets on a top-level window does not erase its exact root
+    // binding. Only successful exact CG absence can establish this separate fact.
+    if !before.scope.sheet
+        && before.scope.parent_window_id.is_none()
+        && after.target_absent
+        && !after.target_owned
+    {
+        return Some(Transition::WindowAbsent);
+    }
+    let (Some(old), Some(new)) = (&before.sheets, &after.sheets) else {
+        return None;
+    };
+    let valid = |ids: &[u32]| {
+        ids.len() <= 32
+            && ids.iter().all(|id| *id > 0)
+            && ids.iter().enumerate().all(|(i, id)| !ids[..i].contains(id))
+    };
+    if !valid(old) || !valid(new) {
+        return None;
+    }
+    if before.scope.sheet {
+        let parent = before.scope.parent_window_id?;
+        if parent == 0
+            || parent == before.scope.window_id
+            || !before.parent_owned
+            || !after.parent_owned
+            || !after.target_absent
+            || after.target_owned
+            || !old.contains(&before.scope.window_id)
+            || new.contains(&before.scope.window_id)
+        {
+            return None;
+        }
+        // A simultaneous sibling replacement is not the admitted close postcondition.
+        let remaining: Vec<_> = old
+            .iter()
+            .copied()
+            .filter(|id| *id != before.scope.window_id)
+            .collect();
+        (remaining == *new).then_some(Transition::ModalClosed)
+    } else {
+        if !after.target_owned
+            || after.target_absent
+            || before.scope.parent_window_id.is_some()
+            || !old.iter().all(|id| new.contains(id))
+        {
+            return None;
+        }
+        let added: Vec<_> = new.iter().filter(|id| !old.contains(id)).collect();
+        (added.len() == 1 && *added[0] != before.scope.window_id).then_some(Transition::ModalOpened)
+    }
+}
