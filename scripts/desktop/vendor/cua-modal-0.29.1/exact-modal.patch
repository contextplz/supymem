+        row.ax_error_code=Some(-25205);row.sheets_available=Some(false);
+        trace.push(row.clone());
+        assert!(trace.explicit_unsupported_inventory(Stage::Capture,0));
+        assert!(!trace.explicit_unsupported_inventory(Stage::AfterAck,1));
+        for (code,reason,available) in [(None,Reason::SheetsUnknown,Some(false)),(Some(-25200),Reason::SheetsUnknown,Some(false)),(Some(-25205),Reason::SheetsMalformed,Some(true)),(Some(-25205),Reason::SheetsUnknown,None)] {
+            row.ax_error_code=code;row.reason=reason;row.sheets_available=available;trace.push(row.clone());
+            assert!(!trace.explicit_unsupported_inventory(Stage::Capture,0));
+        }
