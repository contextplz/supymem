+++ b/crates/platform-macos/src/ax/ancestry_scope.rs
@@ -0,0 +1,229 @@
+//! Pure admission for the nearest actual native ancestor, never AXWindow-first
+//! fallback. A sheet may name its exact containing parent in AXWindow only
+//! when native relationship/PID/SPI/CG identities are all positively proved.
+#[derive(Clone, Copy, Debug)]
+pub struct Surface {
+    pub pid: Option<i32>,
+    pub window_id: Option<u32>,
+    pub sheet: bool,
+    pub cg_owned: bool,
+}
+#[derive(Clone, Copy, Debug)]
+pub enum Hint {
+    Missing,
+    Nearest {
+        native_identity_matches: bool,
+        surface: Surface,
+    },
+    Parent {
+        native_identity_matches: bool,
+        surface: Surface,
+    },
+    Invalid,
+}
+pub fn resolve(pid: i32, nearest: Surface, parent: Option<Surface>, hint: Hint) -> Option<u32> {
+    let owned = |s: Surface| {
+        pid > 0 && s.pid == Some(pid) && s.window_id.is_some_and(|id| id > 0) && s.cg_owned
+    };
+    if !owned(nearest) {
+        return None;
+    }
+    if nearest.sheet {
+        let parent = parent?;
+        if !owned(parent) || parent.window_id == nearest.window_id {
+            return None;
+        }
+    }
+    match hint {
+        Hint::Missing => nearest.window_id,
+        Hint::Nearest {
+            native_identity_matches: true,
+            surface,
+        } if owned(surface)
+            && surface.window_id == nearest.window_id
+            && surface.sheet == nearest.sheet =>
+        {
+            nearest.window_id
+        }
+        Hint::Parent {
+            native_identity_matches: true,
+            surface,
+        } if nearest.sheet
+            && owned(surface)
+            && parent.is_some_and(|p| {
+                p.window_id == surface.window_id && p.pid == surface.pid && p.sheet == surface.sheet
+            }) =>
+        {
+            nearest.window_id
+        }
+        _ => None,
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn window(id: u32, sheet: bool) -> Surface {
+        Surface {
+            pid: Some(42),
+            window_id: Some(id),
+            sheet,
+            cg_owned: true,
+        }
+    }
+    #[test]
+    fn nearest_sheet_wins_only_over_its_actual_proven_parent_hint() {
+        assert_eq!(
+            resolve(
+                42,
+                window(11, true),
+                Some(window(10, false)),
+                Hint::Parent {
+                    native_identity_matches: true,
+                    surface: window(10, false)
+                }
+            ),
+            Some(11)
+        );
+    }
+    #[test]
+    fn direct_sheet_hint_and_missing_hint_use_positive_ancestry() {
+        assert_eq!(
+            resolve(
+                42,
+                window(11, true),
+                Some(window(10, false)),
+                Hint::Nearest {
+                    native_identity_matches: true,
+                    surface: window(11, true)
+                }
+            ),
+            Some(11)
+        );
+        assert_eq!(
+            resolve(42, window(11, true), Some(window(10, false)), Hint::Missing),
+            Some(11)
+        );
+    }
+    #[test]
+    fn ordinary_window_identity_remains_exact() {
+        assert_eq!(
+            resolve(42, window(10, false), None, Hint::Missing),
+            Some(10)
+        );
+        assert_eq!(
+            resolve(
+                42,
+                window(10, false),
+                None,
+                Hint::Nearest {
+                    native_identity_matches: true,
+                    surface: window(10, false)
+                }
+            ),
+            Some(10)
+        );
+        assert_eq!(
+            resolve(
+                42,
+                window(10, false),
+                None,
+                Hint::Parent {
+                    native_identity_matches: true,
+                    surface: window(9, false)
+                }
+            ),
+            None
+        );
+    }
+    #[test]
+    fn unknown_sheet_spi_never_falls_back_to_parent_hint() {
+        let mut s = window(11, true);
+        s.window_id = None;
+        assert_eq!(
+            resolve(
+                42,
+                s,
+                Some(window(10, false)),
+                Hint::Parent {
+                    native_identity_matches: true,
+                    surface: window(10, false)
+                }
+            ),
+            None
+        );
+    }
+    #[test]
+    fn foreign_or_unknown_sheet_pid_never_falls_back() {
+        for pid in [None, Some(7)] {
+            let mut s = window(11, true);
+            s.pid = pid;
+            assert_eq!(resolve(42, s, Some(window(10, false)), Hint::Missing), None);
+        }
+    }
+    #[test]
+    fn closed_or_foreign_sheet_and_parent_hold() {
+        let mut s = window(11, true);
+        s.cg_owned = false;
+        assert_eq!(resolve(42, s, Some(window(10, false)), Hint::Missing), None);
+        let mut p = window(10, false);
+        p.cg_owned = false;
+        assert_eq!(resolve(42, window(11, true), Some(p), Hint::Missing), None);
+    }
+    #[test]
+    fn contradictory_or_alias_hint_holds() {
+        for hint in [
+            Hint::Invalid,
+            Hint::Parent {
+                native_identity_matches: false,
+                surface: window(10, false),
+            },
+            Hint::Parent {
+                native_identity_matches: true,
+                surface: window(12, false),
+            },
+            Hint::Nearest {
+                native_identity_matches: true,
+                surface: window(10, false),
+            },
+        ] {
+            assert_eq!(
+                resolve(42, window(11, true), Some(window(10, false)), hint),
+                None
+            );
+        }
+    }
+    #[test]
+    fn missing_or_same_sheet_parent_holds() {
+        for parent in [None, Some(window(11, false))] {
+            assert_eq!(resolve(42, window(11, true), parent, Hint::Missing), None);
+        }
+    }
+    #[test]
+    fn exact_actual_nested_sheet_parent_can_admit_without_geometry() {
+        let parent = window(10, true);
+        assert_eq!(
+            resolve(
+                42,
+                window(11, true),
+                Some(parent),
+                Hint::Parent {
+                    native_identity_matches: true,
+                    surface: parent
+                }
+            ),
+            Some(11)
+        );
+        assert_eq!(
+            resolve(
+                42,
+                window(11, true),
+                Some(parent),
+                Hint::Parent {
+                    native_identity_matches: true,
+                    surface: window(10, false)
+                }
+            ),
+            None
+        );
+    }
+}
