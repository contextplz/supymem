+        trace.push(row.clone());assert!(trace.explicit_unsupported_inventory(Stage::AfterAck,1));
+        trace.push(Sample::new(Stage::AfterAck,Reason::Unchanged));
+        assert!(!trace.explicit_unsupported_inventory(Stage::AfterAck,1));
+        for _ in 0..20 {trace.push(row.clone());}
+        assert!(!trace.explicit_unsupported_inventory(Stage::AfterAck,1));
+    }
+    #[test]
+    fn sheets_preflight_unknown_is_distinct_from_unavailable_and_malformed() {
+        assert_eq!(sheets_availability(Reason::Timeout, false), None);
+        assert_eq!(sheets_availability(Reason::ParentUnknown, false), None);
+        assert_eq!(
+            sheets_availability(Reason::SheetsUnknown, true),
+            Some(false)
