+++ b/crates/platform-macos/src/ax/control_state.rs
@@ -0,0 +1,176 @@
+//! Closed semantic readback policies for standard native AX controls.
+//! Binary values stay internal; no label/text/hash delta can confirm a press.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Kind {
+    CheckBox,
+    RadioButton,
+    Disclosure,
+    Selection,
+}
+impl Kind {
+    pub fn attribute(self) -> &'static str {
+        match self {
+            Self::Disclosure => "AXExpanded",
+            Self::Selection => "AXSelected",
+            _ => "AXValue",
+        }
+    }
+    pub fn label(self) -> &'static str {
+        match self {
+            Self::CheckBox => "checkbox_toggled",
+            Self::RadioButton => "radio_selected",
+            Self::Disclosure => "disclosure_toggled",
+            Self::Selection => "control_selected",
+        }
+    }
+}
+pub fn policy(role: &str, subrole: Option<&str>) -> Option<Kind> {
+    match (role, subrole) {
+        ("AXCheckBox", _) => Some(Kind::CheckBox),
+        ("AXRadioButton", _) => Some(Kind::RadioButton),
+        ("AXDisclosureTriangle", _) => Some(Kind::Disclosure),
+        ("AXRow" | "AXCell", _) => Some(Kind::Selection),
+        _ => None,
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct State {
+    pub pid: i32,
+    pub window_id: u32,
+    pub kind: Kind,
+    pub identity_proved: bool,
+    pub enabled: Option<bool>,
+    pub value: Option<bool>,
+}
+pub fn confirms(before: State, after: State, stable: State) -> bool {
+    if before.pid <= 0
+        || before.window_id == 0
+        || !before.identity_proved
+        || !after.identity_proved
+        || !stable.identity_proved
+        || before.enabled != Some(true)
+        || after.enabled != Some(true)
+        || stable.enabled != Some(true)
+        || before.pid != after.pid
+        || before.window_id != after.window_id
+        || before.kind != after.kind
+        || after != stable
+    {
+        return false;
+    }
+    let (Some(old), Some(new)) = (before.value, after.value) else {
+        return false;
+    };
+    match before.kind {
+        Kind::RadioButton | Kind::Selection => !old && new,
+        _ => old != new,
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn state(kind: Kind, value: Option<bool>) -> State {
+        State {
+            pid: 42,
+            window_id: 10,
+            kind,
+            identity_proved: true,
+            enabled: Some(true),
+            value,
+        }
+    }
+    #[test]
+    fn checkbox_and_checkbox_toggle_can_flip_in_either_direction() {
+        for kind in [Kind::CheckBox] {
+            for old in [false, true] {
+                let a = state(kind, Some(old));
+                let b = state(kind, Some(!old));
+                assert!(confirms(a, b, b));
+            }
+        }
+    }
+    #[test]
+    fn radio_and_selection_confirm_only_new_positive_selection() {
+        for kind in [Kind::RadioButton, Kind::Selection] {
+            let off = state(kind, Some(false));
+            let on = state(kind, Some(true));
+            assert!(confirms(off, on, on));
