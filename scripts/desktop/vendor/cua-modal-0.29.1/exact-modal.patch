+/// Exact CG identity query for post-action readback. `None` is unavailable or
+/// malformed; `Some(None)` is a successful empty exact-window query. Ordinary
+/// enumeration's Unknown must never be used as proof that a modal closed.
+pub(crate) fn exact_window_pid(window_id: u32) -> Option<Option<i32>> {
+    use core_foundation::{
+        array::CFArray,
+        base::{CFGetTypeID, CFRelease, CFTypeRef, TCFType},
+        dictionary::CFDictionary,
+        number::CFNumber,
+        string::CFString,
+    };
+    use std::os::raw::c_void;
+    if window_id == 0 {
+        return None;
+    }
+    // Apple CGWindow.h: IncludingWindow = 1 << 3, includes only this exact ID.
+    let raw_ref = unsafe { CGWindowListCopyWindowInfo(1 << 3, window_id) };
+    if raw_ref.is_null() {
+        return None;
+    }
+    if unsafe { CFGetTypeID(raw_ref as CFTypeRef) } != CFArray::<CFTypeRef>::type_id() {
+        unsafe {
+            CFRelease(raw_ref as CFTypeRef);
+        }
+        return None;
+    }
+    let array = unsafe { CFArray::<CFTypeRef>::wrap_under_create_rule(raw_ref as _) };
+    if array.len() == 0 {
+        return Some(None);
+    }
+    if array.len() != 1 {
+        return None;
+    }
+    let item = *array.get(0)?;
+    if item.is_null()
+        || unsafe { CFGetTypeID(item) } != CFDictionary::<*const c_void, *const c_void>::type_id()
+    {
+        return None;
+    }
+    let dict =
+        unsafe { CFDictionary::<*const c_void, *const c_void>::wrap_under_get_rule(item as _) };
+    let number = |key: &str| -> Option<i64> {
+        let key = CFString::new(key);
+        let value = *dict.find(key.as_concrete_TypeRef() as *const c_void)?;
+        if value.is_null() || unsafe { CFGetTypeID(value) } != CFNumber::type_id() {
+            return None;
+        }
+        unsafe { CFNumber::wrap_under_get_rule(value as _).to_i64() }
+    };
+    if number("kCGWindowNumber")? != i64::from(window_id) {
+        return None;
+    }
+    let pid = i32::try_from(number("kCGWindowOwnerPID")?).ok()?;
+    (pid > 0).then_some(Some(pid))
+}
