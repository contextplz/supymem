+/// Read-only process identity. Unknown never grants a surface capability.
+pub unsafe fn element_pid(element: AXUIElementRef) -> Option<i32> {
+    let mut pid = 0;
+    (AXUIElementGetPid(element, &mut pid) == kAXErrorSuccess && pid > 0).then_some(pid)
+}
+
+/// A modal's actual parent window; not its overlapping rectangle or model label.
+pub unsafe fn parent_window_id(element: AXUIElementRef) -> Option<u32> {
+    let parent = copy_element_attr(element, "AXParent")?;
+    let result = super::exact_target::element_window_id(parent);
+    CFRelease(parent as CFTypeRef);
+    result
+}
+
+/// Discover nested native surfaces from positively owned AXWindows. Every edge
+/// must agree with the child's own AXParent, every process and CG owner match.
+/// A bounded partial discovery never substitutes a frame match or global input.
+pub unsafe fn copy_nested_surfaces(roots: &[AXUIElementRef], pid: i32) -> Vec<AXUIElementRef> {
+    unsafe fn visit_body(
+        element: AXUIElementRef,
+        parent: Option<AXUIElementRef>,
+        pid: i32,
+        depth: usize,
+        seen: &mut Vec<AXUIElementRef>,
+        found: &mut Vec<AXUIElementRef>,
+        began: std::time::Instant,
+    ) {
+        if depth > 12
+            || seen.len() >= 512
+            || began.elapsed() > std::time::Duration::from_millis(250)
+        {
+            return;
+        }
+        if seen
+            .iter()
+            .any(|&old| CFEqual(old as CFTypeRef, element as CFTypeRef) != 0)
+        {
+            return;
+        }
+        if element_pid(element) != Some(pid) {
+            return;
+        }
+        if let Some(expected) = parent {
+            let Some(actual) = copy_element_attr(element, "AXParent") else {
+                return;
+            };
+            let matches = CFEqual(actual as CFTypeRef, expected as CFTypeRef) != 0;
+            CFRelease(actual as CFTypeRef);
+            if !matches {
+                return;
+            }
+        }
+        CFRetain(element as CFTypeRef); // keep identity comparisons live through the bounded walk
+        seen.push(element);
+        let role = copy_string_attr(element, "AXRole").unwrap_or_default();
+        if parent.is_some() && matches!(role.as_str(), "AXWindow" | "AXSheet") {
+            let wid = ax_get_window_id(element);
+            let parent_wid = parent_window_id(element);
+            let facts = super::modal_scope::SurfaceFacts {
+                pid: element_pid(element),
+                native_window_role: true,
+                parent_matches: true,
+                window_id: wid,
+                parent_window_id: parent_wid,
+                parent_cg_owned: parent_wid.is_some_and(|wid| {
+                    matches!(
+                        crate::windows::resolve_window_owner(pid, wid),
+                        crate::windows::WindowOwner::SamePid
+                    )
+                }),
+                cg_owned: wid.is_some_and(|wid| {
+                    matches!(
+                        crate::windows::resolve_window_owner(pid, wid),
+                        crate::windows::WindowOwner::SamePid
+                    )
+                }),
+            };
+            if super::modal_scope::admit(pid, &facts).is_some() {
+                CFRetain(element as CFTypeRef);
+                found.push(element);
+            }
+        }
+        AXUIElementSetMessagingTimeout(element, 0.02);
+        for child in copy_children(element) {
+            visit(child, Some(element), pid, depth + 1, seen, found, began);
+            CFRelease(child as CFTypeRef);
+        }
+        AXUIElementSetMessagingTimeout(element, 0.0);
+    }
+    unsafe fn visit(
+        element: AXUIElementRef,
+        parent: Option<AXUIElementRef>,
+        pid: i32,
+        depth: usize,
+        seen: &mut Vec<AXUIElementRef>,
+        found: &mut Vec<AXUIElementRef>,
+        began: std::time::Instant,
+    ) {
+        AXUIElementSetMessagingTimeout(element, 0.02);
+        visit_body(element, parent, pid, depth, seen, found, began);
+        AXUIElementSetMessagingTimeout(element, 0.0);
+    }
+    let mut seen = Vec::new();
+    let mut found = Vec::new();
+    let began = std::time::Instant::now();
+    for &root in roots {
+        visit(root, None, pid, 0, &mut seen, &mut found, began);
+    }
+    for element in seen {
+        CFRelease(element as CFTypeRef);
+    }
+    found
+}
