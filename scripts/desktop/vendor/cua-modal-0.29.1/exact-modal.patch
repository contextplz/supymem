+    }
+    /// At most three fresh readbacks, no dispatch/replay. Time is only a stop
+    /// budget, never evidence. Unknown or unrelated changes remain unconfirmed.
+    pub unsafe fn after_acknowledged(&self) -> Option<Transition> {
+        let began = Instant::now();
