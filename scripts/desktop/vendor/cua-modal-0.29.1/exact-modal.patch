+        for reason in [
+            Reason::SheetsMalformed,
+            Reason::SheetsPartial,
+            Reason::Timeout,
+            Reason::ParentUnknown,
+        ] {
+            assert_eq!(sheets_availability(reason, true), Some(true));
+        }
+    }
+    #[test]
+    fn cg_unknown_absent_foreign_and_owned_remain_distinct() {
+        assert_eq!(cg_facts(None, 42), (None, None));
+        assert_eq!(cg_facts(Some(None), 42), (Some(false), Some(false)));
+        assert_eq!(cg_facts(Some(Some(9)), 42), (Some(true), Some(false)));
+        assert_eq!(cg_facts(Some(Some(42)), 42), (Some(true), Some(true)));
+        assert_eq!(cg_facts(Some(Some(42)), 0), (None, None));
+    }
+    #[test]
+    fn trace_is_owned_and_bounded() {
+        let first = Trace::default();
+        let clone = first.clone();
+        let other = Trace::default();
+        for _ in 0..20 {
+            clone.push(Sample::new(Stage::Capture, Reason::SheetsUnknown));
+        }
+        assert_eq!(first.snapshot().0.len(), 16);
+        assert!(first.snapshot().1);
+        assert!(other.snapshot().0.is_empty());
+    }
+    #[test]
+    fn unknown_ax_numeric_and_oversize_facts_never_leave_trace() {
+        let trace = Trace::default();
+        let mut row = Sample::new(Stage::Capture, Reason::SheetsUnknown);
+        row.ax_error_code = Some(-25204);
+        trace.push(row.clone());
+        row.ax_error_code = Some(123);
+        trace.push(row.clone());
+        row.sheets_count = Some(33);
+        trace.push(row);
+        let rows = trace.snapshot().0;
