+                // root; never infer parent identity from the absent child's ID.
+                let parent_exact=self.parent.as_ref().is_some_and(|parent| {
+                    let Some(_timeout)=Timeout::set(parent.0) else {return false;};
+                    element_pid(parent.0)==Some(after.scope.pid)
+                        && ax_get_window_id(parent.0)==after.scope.parent_window_id
+                        && copy_string_attr(parent.0,"AXRole").as_deref()==Some("AXWindow")
+                });
+                let unsupported=after.sheets.is_none() && self.trace.explicit_unsupported_inventory(Stage::AfterAck,attempt+1);
+                let owner=crate::windows::exact_window_pid(after.scope.window_id);
+                let parent_owner=after.scope.parent_window_id.and_then(crate::windows::exact_window_pid);
+                after.target_owned=owner==Some(Some(after.scope.pid));
+                after.target_absent=owner==Some(None);
+                after.parent_owned=parent_owner==Some(Some(after.scope.pid));
+                (sample.target_cg_present,sample.target_cg_owned)=super::press_diagnostic::cg_facts(owner,after.scope.pid);
+                sample.parent_cg_owned=super::press_diagnostic::cg_facts(parent_owner,after.scope.pid).1;
+                sample.parent_identity_exact=Some(parent_exact);
+                binding.confirm(&after,parent_exact,native_generation(after.scope.pid).as_deref(),unsupported)
+            } else {press_readback::confirm(&self.before, &after)};
+            sample.reason = if effect.is_some() {
+                Reason::Confirmed
+            } else {
+                Reason::Unchanged
+            };
+            sample.target_sheet_listed = after
+                .sheets
+                .as_ref()
+                .map(|ids| ids.contains(&after.scope.window_id));
+            self.trace.push(sample);
+            if let Some(effect) = effect {
+                return Some(effect);
+            }
+            if attempt < 2 {
+                std::thread::sleep(Duration::from_millis(40));
+            }
+        }
+        self.trace
+            .push(Sample::new(Stage::Final, Reason::Unchanged));
+        None
+    }
+}
+
+pub fn diagnostic_json(trace: &Trace) -> serde_json::Value {
+    let (samples, truncated) = trace.snapshot();
+    serde_json::json!({"protocol":"supymem_press_probe_metadata_v1","truncated":truncated,"samples":samples.iter().map(|s|serde_json::json!({
+        "stage":s.stage.label(),"reason":s.reason.label(),"sample_index":s.sample_index,
+        "target_cg_present":s.target_cg_present,"target_cg_owned":s.target_cg_owned,
+        "parent_cg_owned":s.parent_cg_owned,"parent_identity_exact":s.parent_identity_exact,
+        "sheets_available":s.sheets_available,"sheets_count":s.sheets_count,
+        "target_sheet_listed":s.target_sheet_listed,"ax_error_code":s.ax_error_code
+    })).collect::<Vec<_>>()})
+}
+
+/// Convert only this invocation's closed native trace, not arbitrary tool JSON.
+pub fn typed_diagnostic(trace: &Trace) -> Option<cua_driver_contract::NativeProbeDiagnostics> {
+    let value = serde_json::from_value::<cua_driver_contract::NativeProbeDiagnostics>(
+        diagnostic_json(trace),
+    )
+    .ok()?;
+    value.validate().then_some(value)
+}
+
+/// Native permission relation only. Explicitly unsupported AXSheets is distinct
+/// from any malformed/partial/refused/unknown inventory. No effect is inferred.
+pub(crate) unsafe fn reviewed_direct_modal_relation(
+    child: AXUIElementRef, pid: i32, parent_wid: u32, child_wid: u32,
+) -> Option<cua_driver_core::owned_modal::SheetInventory> {
+    let began=Instant::now();
+    if pid<=0 || parent_wid==0 || child_wid==0 || parent_wid==child_wid { return None; }
+    let _child_timeout=Timeout::set(child)?;
+    if element_pid(child)!=Some(pid) || ax_get_window_id(child)!=Some(child_wid)
+        || copy_string_attr(child,"AXRole").as_deref()!=Some("AXSheet")
+        || crate::windows::exact_window_pid(child_wid)!=Some(Some(pid)) { return None; }
+    let parent=Element(copy_element_attr(child,"AXParent")?);
+    let _parent_timeout=Timeout::set(parent.0)?;
+    if element_pid(parent.0)!=Some(pid) || ax_get_window_id(parent.0)!=Some(parent_wid)
+        || copy_string_attr(parent.0,"AXRole").as_deref()!=Some("AXWindow")
+        || crate::windows::exact_window_pid(parent_wid)!=Some(Some(pid)) { return None; }
+    let trace=Trace::default();
+    let status=match sheets(parent.0,pid,parent_wid,began,&trace,Stage::Capture,0) {
+        Some(ids) => cua_driver_core::owned_modal::classify_sheet_inventory(Some(&ids),child_wid,None,true)?,
+        None => {
+            let (rows,truncated)=trace.snapshot();
+            if truncated || rows.len()!=1 || rows[0].reason!=Reason::SheetsUnknown
+                || rows[0].ax_error_code!=Some(kAXErrorAttributeUnsupported)
+                || rows[0].sheets_available!=Some(false) { return None; }
+            cua_driver_core::owned_modal::classify_sheet_inventory(None,child_wid,rows[0].ax_error_code,true)?
+        }
+    };
+    // Inventory status never rescues a changed native relation or expired read.
+    let fresh_parent=Element(copy_element_attr(child,"AXParent")?);
+    if CFEqual(fresh_parent.0 as CFTypeRef,parent.0 as CFTypeRef)==0
+        || element_pid(child)!=Some(pid) || element_pid(parent.0)!=Some(pid)
+        || ax_get_window_id(child)!=Some(child_wid) || ax_get_window_id(parent.0)!=Some(parent_wid)
+        || copy_string_attr(child,"AXRole").as_deref()!=Some("AXSheet")
+        || copy_string_attr(parent.0,"AXRole").as_deref()!=Some("AXWindow")
+        || crate::windows::exact_window_pid(child_wid)!=Some(Some(pid))
+        || crate::windows::exact_window_pid(parent_wid)!=Some(Some(pid))
+        || began.elapsed()>Duration::from_millis(150) { return None; }
+    Some(status)
+}
