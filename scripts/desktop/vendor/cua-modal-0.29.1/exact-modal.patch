+//! Native-only direct sheet resolver. No labels, screenshots, user text,
+//! permission mutation, input dispatch, model data or parent hints are used.
+use super::bindings::*;
+use core_foundation::base::{CFRelease, CFTypeRef};
+use cua_driver_core::owned_modal::{NativeModalFacts, ReviewedModalParent};
+use std::time::{Duration, Instant};
+struct Element(AXUIElementRef);
+impl Drop for Element {
+    fn drop(&mut self) {
+        unsafe {
+            CFRelease(self.0 as CFTypeRef);
+        }
+    }
+}
+struct Timeout(AXUIElementRef);
+impl Timeout {
+    unsafe fn set(e: AXUIElementRef) -> Option<Self> {
+        (AXUIElementSetMessagingTimeout(e, 0.02) == kAXErrorSuccess).then_some(Self(e))
+    }
+}
+impl Drop for Timeout {
+    fn drop(&mut self) {
+        unsafe {
+            AXUIElementSetMessagingTimeout(self.0, 0.0);
+        }
+    }
+}
+fn generation(pid: i32) -> Option<String> {
+    let (sec, usec) = super::enablement::process_start_stamp(pid)?;
+    cua_driver_core::owned_modal::kernel_identity(sec, usec)
+}
+pub fn resolve(
+    parent: &ReviewedModalParent,
+    child_pid: i64,
+    child_wid: u64,
+) -> Option<NativeModalFacts> {
+    let began = Instant::now();
+    let pid = i32::try_from(child_pid).ok()?;
+    let wid = u32::try_from(child_wid).ok()?;
+    let parent_wid = u32::try_from(parent.window_id).ok()?;
+    if pid <= 0 || parent.pid != child_pid || wid == 0 || parent_wid == 0 || wid == parent_wid {
+        return None;
+    }
+    let before = generation(pid)?;
+    if before != parent.process_start_identity {
+        return None;
+    }
+    unsafe {
+        let app = AXUIElementCreateApplication(pid);
+        if app.is_null() {
+            return None;
+        }
+        let app = Element(app);
+        let _timeout = Timeout::set(app.0)?;
+        let windows: Vec<Element> = copy_ax_windows_including(app.0, pid, wid)
+            .into_iter()
+            .map(Element)
+            .collect();
+        if windows.len() > 128 || began.elapsed() > Duration::from_millis(250) {
+            return None;
+        }
+        let mut selected = None;
+        for element in &windows {
+            let _timeout = Timeout::set(element.0)?;
+            if began.elapsed() > Duration::from_millis(250) {
+                return None;
+            }
+            if ax_get_window_id(element.0) == Some(wid) {
+                // Ambiguous duplicate roots cannot acquire a child lease.
+                if selected.is_some() {
+                    return None;
+                }
+                if element_pid(element.0) != Some(pid) {
+                    return None;
+                }
+                selected = Some(element.0);
+            }
+        }
+        let inventory =
+            super::press_probe::reviewed_direct_modal_relation(selected?, pid, parent_wid, wid)?;
+        let after = generation(pid)?;
+        if before != after
+            || after != parent.process_start_identity
+            || began.elapsed() > Duration::from_millis(250)
+        {
+            return None;
+        }
+        Some(NativeModalFacts {
+            parent_pid: parent.pid,
+            parent_window_id: parent.window_id,
+            child_pid,
+            child_window_id: child_wid,
+            process_start_before: before,
+            process_start_after: after,
+            exact_parent_ax_root: true,
+            exact_child_ax_sheet: true,
+            native_parent_matches: true,
+            parent_sheet_inventory: inventory,
+            parent_cg_owned: true,
+            child_cg_owned: true,
+            within_read_budget: true,
+        })
+    }
+}
