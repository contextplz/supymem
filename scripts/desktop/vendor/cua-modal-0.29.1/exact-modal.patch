+        assert_eq!(rows[0].ax_error_code, Some(-25204));
+        assert_eq!(rows[1].ax_error_code, None);
+    }
+    #[test]
+    fn no_content_or_identity_channel_in_closed_samples() {
+        let row = Sample::new(Stage::AfterAck, Reason::Unchanged);
