{# The three points. Exactly three, enforced by the linter, never model-chosen. #}
  <section class="points reveal">
    <h2>{{ points_heading }}</h2>
    <div class="grid">
      {% for point in copy.points %}
      <div class="card">
        <h3>{{ point.title }}</h3>
        <p>{{ point.body }}</p>
      </div>
      {% endfor %}
    </div>
  </section>
