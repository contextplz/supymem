{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Supymem",
  "version": "1.0.0-rc.2",
  "identifier": "com.companyos.app",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:3100",
    "beforeBuildCommand": "",
    "frontendDist": "splashscreen"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Supymem",
        "width": 1280,
        "height": 840,
        "minWidth": 884,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "titleBarStyle": "Overlay",
        "theme": "Light",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "trafficLightPosition": { "x": 18, "y": 26 }
      },
      {
        "label": "setup",
        "title": "Set up this Mac",
        "url": "setup.html",
        "width": 680,
        "height": 720,
        "resizable": true,
        "visible": false,
        "alwaysOnTop": true,
        "maximizable": false
      },
      {
        "label": "coach",
        "title": "Turn this on",
        "url": "coach.html",
        "width": 400,
        "height": 600,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' asset: http://asset.localhost data: blob:; connect-src 'self' blob: ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "third_party/PEEKABOO_LICENSE.txt",
      "third_party/CUA_LICENSE.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/companyos-runtime",
      "binaries/peekaboo",
      "binaries/cua-driver",
      "binaries/cua-cursor-theme"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "files": {
        "MacOS/libswiftCompatibilitySpan.dylib": "binaries/libswiftCompatibilitySpan.dylib"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {}
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGOTEyQjQxNTRBNDA2QQpSV1JxUUVvVnRCTDVDcUVEQmhzZUw4WS9GR1dsNk9hejArREo2Uk9wSDByR0FxWG1XTEYxTUt2Two=",
      "endpoints": [
        "https://supymem.com/downloads/latest.json"
      ]
    }
  }
}
