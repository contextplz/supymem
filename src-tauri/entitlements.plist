<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- PyInstaller's one-file runtime extracts its signed Python framework at
       launch. Hardened macOS builds must permit that bundled runtime to load. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Hardened runtime silently denies mic capture and direct Apple events
       (the first-run permission screen) without these two. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
