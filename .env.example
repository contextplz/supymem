# Supymem works without this file. Prefer Settings > Keys and connections.
# For import, save a private copy as .env at the path shown on that screen.
# Source browser launchers also read checkout .env; the desktop reads its data-folder file only.
# Uncomment only what you need and restart. In-app saves take precedence per field.
# Never commit a filled-in .env. See docs/self-hosting/keys.md for connection details.
# See .env.local.example for source browser overrides. Coding tools use your subscription login.

# Local mode for direct source runs; the launchers and local Compose set it for you.
SUPYMEM_MODE=local
# Leave guessed email addresses off; sending still requires your mail settings and compliance checks.
GUESSED_EMAILS=off

# Your model: openai, azure_openai, anthropic, or openai_compatible.
# SUPYMEM_LLM_PROVIDER=
# Chat model name or Azure deployment name.
# SUPYMEM_MODEL_CHAT=
# Optional planning, extraction, vision, and realtime model names.
# SUPYMEM_MODEL_PLANNING=
# SUPYMEM_MODEL_EXTRACTION=
# SUPYMEM_MODEL_VISION=
# SUPYMEM_MODEL_REALTIME=
# OpenAI API key and optional endpoint override.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# Azure OpenAI API key and your deployment's endpoint.
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# Anthropic API key and optional endpoint override.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# OpenAI-compatible server URL and key (a loopback server can omit the key).
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=

# Search: builtin needs no key; tavily, exa, openai, and firecrawl are optional.
# SUPYMEM_SEARCH_PROVIDER=builtin
# Tavily and Exa keys, only for the selected provider.
# TAVILY_API_KEY=
# EXA_API_KEY=
# Firecrawl server URL and optional token; FIRECRAWL_API_KEY is a token alias.
# FIRECRAWL_SELF_HOSTED_URL=
# FIRECRAWL_SELF_HOSTED_TOKEN=
# FIRECRAWL_API_KEY=

# Outgoing mail server and port (465 for implicit TLS or 587 for STARTTLS).
# SMTP_HOST=
# SMTP_PORT=
# Account used to sign in and send; SMTP_FROM and SMTP_USERNAME are aliases.
# SMTP_USER=
# SMTP_FROM=
# SMTP_USERNAME=
# Mail account password or app password.
# SMTP_PASSWORD=
# Sender display name and postal address included with outreach.
# SMTP_SENDER_NAME=
# SMTP_POSTAL_ADDRESS=
# Incoming mail server and port (993 by default) for reading replies.
# IMAP_HOST=
# IMAP_PORT=
# Optional booking link Charlie can use in outreach.
# SMTP_BOOKING_LINK=
# Older import aliases for the mail settings above. Use only one name per field.
# SUPYMEM_SMTP_HOST=
# SUPYMEM_SMTP_PORT=
# SUPYMEM_SMTP_USERNAME=
# SUPYMEM_SMTP_PASSWORD=
# SENDER_NAME=
# SUPYMEM_SENDER_NAME=
# SENDER_POSTAL_ADDRESS=
# SUPYMEM_SENDER_POSTAL_ADDRESS=
# SUPYMEM_IMAP_HOST=
# SUPYMEM_IMAP_PORT=
# SUPYMEM_BOOKING_LINK=

# Publishing destination: vercel, netlify, or s3 (your own account).
# SUPYMEM_PUBLISH_PROVIDER=
# Vercel API token and existing project name.
# VERCEL_TOKEN=
# VERCEL_PROJECT_NAME=
# Netlify API token and existing site ID.
# NETLIFY_AUTH_TOKEN=
# NETLIFY_SITE_ID=
# S3 publishing credentials, with a session token for temporary credentials.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# S3 bucket region; AWS_DEFAULT_REGION is an alias.
# AWS_REGION=
# AWS_DEFAULT_REGION=
# S3 bucket and optional object prefix; AWS_S3_BUCKET and AWS_S3_PREFIX are aliases.
# SUPYMEM_S3_BUCKET=
# SUPYMEM_S3_PREFIX=
# AWS_S3_BUCKET=
# AWS_S3_PREFIX=
# Your site's public URL; SUPYMEM_PUBLIC_URL is an alias.
# SUPYMEM_SITE_URL=
# SUPYMEM_PUBLIC_URL=
# Optional email address for page signups.
# SUPYMEM_WAITLIST_EMAIL=

# Your Composio API key and a JSON object mapping toolkit slugs to auth config IDs.
# COMPOSIO_API_KEY=
# SUPYMEM_COMPOSIO_AUTH_CONFIGS=

# Optional ComfyUI server URL for images.
# COMFYUI_URL=
# BFL image key; BFL_API_TOKEN is an alias.
# BFL_API_KEY=
# BFL_API_TOKEN=
# Gemini image key; GOOGLE_API_KEY and GOOGLE_GENERATIVE_AI_API_KEY are aliases.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# Pexels stock image key and Pixabay key (availability check only).
# PEXELS_API_KEY=
# PIXABAY_API_KEY=

# Monthly local model spend limit in USD; zero blocks estimated paid calls.
# SUPYMEM_LOCAL_MONTHLY_CAP_USD=
# Absolute backup directory outside your app's data folder.
# SUPYMEM_BACKUP_DIRECTORY=

# Optional local Docker settings (docs/self-hosting/install.md).
# Host ports for the Docker console and API; these also work for source browser mode.
# CONSOLE_PORT=3100
# CORE_PORT=3300
# Leave profiles unset for SQLite and built-in research. Before enabling firecrawl, see the optional Firecrawl setup in docs/self-hosting/install.md.
# Options: postgres, firecrawl, or both comma-separated.
# COMPOSE_PROFILES=
# Optional database URL; leave unset for SQLite. Enabling Postgres does not move existing data.
# COMPANY_OS_DB_URL=
# Optional Docker Postgres user, password, database and host port; set the password before enabling the profile.
# POSTGRES_USER=local
# POSTGRES_PASSWORD=
# POSTGRES_DB=local
# POSTGRES_HOST_PORT=55432
# Supply your own upstream Firecrawl v2.11.0 checkout; vendor/firecrawl is not in the public export.
# Supply a SearXNG settings.yml directory with JSON enabled in search.formats.
# FIRECRAWL_SOURCE_DIR=
# FIRECRAWL_SEARCH_CONFIG_DIR=
# Firecrawl database user, password, and name, plus its queue key; set both secrets before enabling Firecrawl.
# FIRECRAWL_POSTGRES_USER=
# FIRECRAWL_POSTGRES_PASSWORD=
# FIRECRAWL_POSTGRES_DB=
# FIRECRAWL_BULL_AUTH_KEY=
# Firecrawl forwarding port bound to this computer.
# FIRECRAWL_PORT=3002
# Legacy model inputs still passed to local containers. Use the model import settings above for new setups.
# LLM_PROVIDER=
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_API_VERSION=
# LLM_DEPLOYMENT_NAME=
# LLM_DEPLOYMENT_PRO=
# LLM_DEPLOYMENT_FLASH=

# Developer-only: run without live model calls, or select the test cassette mode.
# LLM_OFFLINE=
# LLM_CASSETTE_MODE=
