# Optional source browser overrides for ./start --web or .\start.ps1 --web.
# Copy only the settings you need into .env in your checkout, not .env.local.
# Use .env.example or Settings > Keys and connections for keys.

# Console, API, worker health, and bridge loopback ports; keep them distinct.
# CONSOLE_PORT=3100
# CORE_PORT=3300
# WORKER_HEALTH_PORT=3301
# BRIDGE_PORT=3500

# Data folder; defaults to data/runtime/local. SUPYMEM_DATA_DIR is an alias.
# COMPANY_OS_DATA_DIR=
# SUPYMEM_DATA_DIR=
# Optional working-memory SQLite path; defaults to working_memory.sqlite3 in the data folder.
# COMPANY_OS_WORKING_MEMORY_PATH=
# Optional saved-page assets folder; defaults to the app data folder.
# FIRSTLOOK_DATA_DIR=
# Leave database URLs unset for the default SQLite file. To select an existing SQLite file
# inside your data folder, set COMPANY_OS_DB_URL; DATABASE_URL and DB_URL are aliases.
# COMPANY_OS_DB_URL=
# DATABASE_URL=
# DB_URL=

# Optional source worker process limits; leave unset for the app defaults.
# WORKER_CONCURRENCY=8
# WORKER_JOB_CLASSES=all
# JOB_WORKSPACE_INFLIGHT_CAP=8
# Optional spacing in seconds between Firecrawl requests and simultaneous requests per process.
# FIRECRAWL_MIN_INTERVAL_SECONDS=6.5
# FIRECRAWL_PROCESS_CONCURRENCY=3
# Optional timeout in seconds for Charlie's clarifying question.
# LLM_CLARIFY_TIMEOUT_SECONDS=180
# Optional developer switch for interpretation of chat requests (on by default).
# CHAT_REPHRASE=on
